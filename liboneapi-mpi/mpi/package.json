{
  "platforms":
  {
    "x86_64-windows":
    {
      "mpi":
      {
        "linked": [
          { "dll": "mpi-runtime/bin/impi.dll", "libs": ["mpi-devel/lib/impi.lib"] }
        ]
      }
    },
    "x86_64-linux":
    {
      "mpi":
      {
        "shared": ["mpi-runtime/lib/libmpi.so"]
      },
      "mpicxx":
      {
        "shared":  ["mpi-runtime/lib/libmpicxx.so"],
        "depends": ["mpi"]
      },
      "mpifort":
      {
        "shared":  ["mpi-runtime/lib/libmpifort.so"],
        "depends": ["mpi"]
      }
    }
  },
  "exes":
  {
    "x86_64-windows":
    {
      "mpiexec":   "mpi-runtime/bin/mpiexec",
      "impi_info": "mpi-runtime/bin/impi_info"
    },
    "x86_64-linux":
    {
      "mpiexec":   "mpi-runtime/bin/mpiexec",
      "impi_info": "mpi-runtime/bin/impi_info"
    }
  }
}
