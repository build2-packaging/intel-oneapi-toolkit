{
  "platforms":
  {
    "x86_64-windows":
    {
      "libs":
      {
        "mpi":
        {
          "linked": [
            { "dll": "mpi-runtime/bin/impi.dll", "libs": ["mpi-devel/lib/impi.lib"] }
          ]
        }
      },
      "exes":
      {
        "mpiexec":   {"path": "mpi-runtime/bin/mpiexec.exe",   "depends": []},
        "impi_info": {"path": "mpi-runtime/bin/impi_info.exe", "depends": ["mpi"]}
      }
    },

    "x86_64-linux":
    {
      "libs":
      {
        "mpi":
        {
          "shared": ["mpi-runtime/lib/libmpi.so"]
        },
        "mpicxx":
        {
          "shared":  ["mpi-runtime/lib/libmpicxx.so"],
          "depends": ["mpi"]
        },
        "mpifort":
        {
          "shared":  ["mpi-runtime/lib/libmpifort.so"],
          "depends": ["mpi"]
        }
      },
      "exes":
      {
        "mpiexec":   {"path": "mpi-runtime/bin/mpiexec",   "depends": []},
        "impi_info": {"path": "mpi-runtime/bin/impi_info", "depends": ["mpi"]}
      }
    }
  }
}
