# Uncomment to suppress warnings coming from external libraries.
#
#cxx.internal.scope = current

cxx.std = latest

using c
using cxx

h{*}:   extension = h
c{*}:   extension = c
hxx{*}: extension = hpp
cxx{*}: extension = cpp

# Since the executables are prebuilt, the normally run link-rule never
# assigns it explicitly. Let's be explicit here and in package.json.
#
if ($cc.target.class == 'windows')
  exe{*}: extension = exe

config [dir_path] config.liboneapi_ifort.cache ?= \
  (!$null($config.liboneapi.cache) ? $config.liboneapi.cache : $out_root)

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $cxx.target
